/**
 * translate-dreams-uz.mts
 * Translates all 505 dreams from Russian to Uzbek using Gemini API.
 * Run: npx tsx scripts/translate-dreams-uz.mts
 * Output: data/dreams-uz.ts
 */

import { readFileSync, writeFileSync, existsSync } from 'fs';
import { GoogleGenerativeAI } from '@google/generative-ai';

// Load env
const envRaw = readFileSync('.env.local', 'utf8');
const env: Record<string, string> = {};
for (const line of envRaw.split('\n')) {
  const i = line.indexOf('=');
  if (i > 0) env[line.slice(0, i).trim()] = line.slice(i + 1).trim();
}

const GEMINI_API_KEY = env['GEMINI_API_KEY'];
if (!GEMINI_API_KEY) throw new Error('GEMINI_API_KEY not found in .env.local');

// Dynamic import of dreams (tsx handles TS)
const { dreams } = await import('../data/dreams.js');

const genai = new GoogleGenerativeAI(GEMINI_API_KEY);
const model = genai.getGenerativeModel({ model: 'gemini-2.0-flash' });

const BATCH_SIZE = 5;
const OUTPUT_FILE = 'data/dreams-uz.ts';
const CACHE_FILE = 'scripts/dreams-uz-cache.json';

// Load existing cache
let cache: Record<string, DreamUz> = {};
if (existsSync(CACHE_FILE)) {
  cache = JSON.parse(readFileSync(CACHE_FILE, 'utf8'));
  console.log(`Loaded cache: ${Object.keys(cache).length} dreams already translated`);
}

interface DreamUz {
  title: string;
  short: string;
  full: string;
  forWoman: string;
  forMan: string;
  byDay: Record<string, string>;
  tags: string[];
}

async function translateBatch(batch: typeof dreams): Promise<Record<string, DreamUz>> {
  const payload = batch.map(d => ({
    slug: d.slug,
    title: d.title,
    short: d.short,
    full: d.full,
    forWoman: d.forWoman,
    forMan: d.forMan,
    byDay: d.byDay,
    tags: d.tags,
  }));

  const prompt = `Переведи следующие данные о снах с русского на узбекский язык (латиница, официальный узбекский).
Сохрани JSON структуру точно.
Поля для перевода: title, short, full, forWoman, forMan, byDay (все дни), tags.
НЕ переводи: slug.
Отвечай ТОЛЬКО валидным JSON массивом, без markdown, без пояснений.

Данные:
${JSON.stringify(payload, null, 2)}`;

  const result = await model.generateContent(prompt);
  const text = result.response.text().trim();

  // Extract JSON
  const jsonMatch = text.match(/\[[\s\S]*\]/);
  if (!jsonMatch) throw new Error(`No JSON array in response: ${text.slice(0, 200)}`);

  const translated: Array<{ slug: string } & DreamUz> = JSON.parse(jsonMatch[0]);

  const out: Record<string, DreamUz> = {};
  for (const item of translated) {
    const { slug, ...rest } = item;
    out[slug] = rest;
  }
  return out;
}

async function sleep(ms: number) {
  return new Promise(resolve => setTimeout(resolve, ms));
}

// Filter dreams not yet in cache
const remaining = dreams.filter(d => !cache[d.slug]);
console.log(`Total dreams: ${dreams.length}, remaining to translate: ${remaining.length}`);

for (let i = 0; i < remaining.length; i += BATCH_SIZE) {
  const batch = remaining.slice(i, i + BATCH_SIZE);
  const batchNum = Math.floor(i / BATCH_SIZE) + 1;
  const total = Math.ceil(remaining.length / BATCH_SIZE);

  console.log(`Batch ${batchNum}/${total}: translating ${batch.map(d => d.slug).join(', ')}`);

  let attempts = 0;
  while (attempts < 3) {
    try {
      const translated = await translateBatch(batch);
      Object.assign(cache, translated);
      // Save cache after each batch
      writeFileSync(CACHE_FILE, JSON.stringify(cache, null, 2));
      console.log(`  ✓ Done (${Object.keys(cache).length}/${dreams.length} total)`);
      break;
    } catch (err) {
      attempts++;
      console.error(`  ✗ Attempt ${attempts} failed: ${err}`);
      if (attempts < 3) await sleep(3000);
    }
  }

  // Rate limit: ~15 req/min on Gemini free tier
  if (i + BATCH_SIZE < remaining.length) await sleep(4500);
}

// Generate TypeScript output
console.log('\nGenerating data/dreams-uz.ts...');

const lines: string[] = [
  '// Auto-generated by scripts/translate-dreams-uz.mts',
  '// Do not edit manually — re-run the script to regenerate',
  '',
  'export interface DreamUzTranslation {',
  '  title: string;',
  '  short: string;',
  '  full: string;',
  '  forWoman: string;',
  '  forMan: string;',
  '  byDay: Record<string, string>;',
  '  tags: string[];',
  '}',
  '',
  'export const dreamsUz: Record<string, DreamUzTranslation> = {',
];

for (const dream of dreams) {
  const uz = cache[dream.slug];
  if (!uz) {
    console.warn(`  WARNING: no translation for ${dream.slug}, using Russian fallback`);
    continue;
  }

  lines.push(`  '${dream.slug}': {`);
  lines.push(`    title: ${JSON.stringify(uz.title)},`);
  lines.push(`    short: ${JSON.stringify(uz.short)},`);
  lines.push(`    full: ${JSON.stringify(uz.full)},`);
  lines.push(`    forWoman: ${JSON.stringify(uz.forWoman)},`);
  lines.push(`    forMan: ${JSON.stringify(uz.forMan)},`);
  lines.push(`    byDay: {`);
  for (const [day, text] of Object.entries(uz.byDay)) {
    lines.push(`      ${day}: ${JSON.stringify(text)},`);
  }
  lines.push(`    },`);
  lines.push(`    tags: ${JSON.stringify(uz.tags)},`);
  lines.push(`  },`);
}

lines.push('};');

writeFileSync(OUTPUT_FILE, lines.join('\n'));
console.log(`✓ Written ${OUTPUT_FILE} (${Object.keys(cache).length} dreams)`);
