/**
 * translate-horoscopes-uz.mts
 * Generates data/horoscopes-uz.ts with:
 *  - zodiacSignsUz: hardcoded metadata (dates/elements/planets/traits/descriptions)
 *  - dailyPoolUz: 4 daily variants per sign (rotated by day index)
 *  - weeklyHoroscopesUz: translated weekly content
 *  - monthlyHoroscopesUz: translated monthly content
 * Run: npx tsx scripts/translate-horoscopes-uz.mts
 */

import { writeFileSync } from 'fs';

const SEP = ' [|||] ';
const DELAY = 7000;

async function gt(text: string): Promise<string> {
  await new Promise(r => setTimeout(r, DELAY));
  const url = `https://translate.googleapis.com/translate_a/single?client=gtx&sl=ru&tl=uz&dt=t&q=${encodeURIComponent(text)}`;
  const res = await fetch(url);
  const data = await res.json() as [string, unknown][][];
  return (data[0] as [string][]).map(s => s[0]).join('');
}

async function translateBatch(fields: string[]): Promise<string[]> {
  const combined = fields.join(SEP);
  const translated = await gt(combined);
  const parts = translated.split(/\s*\[\|\|\|\]\s*/);
  if (parts.length !== fields.length) {
    // fallback: translate one by one
    const result: string[] = [];
    for (const f of fields) result.push(await gt(f));
    return result;
  }
  return parts;
}

